# Identity provider's confidential client used only by the MCP backend.
# Register <MCP_OAUTH_ISSUER_URL>/oauth/callback as its valid redirect URI.
OIDC_ISSUER_URL=https://auth.example.com/realms/example
OIDC_CLIENT_ID=pardis-mcp-backend
OIDC_CLIENT_SECRET=replace-me

# Public URLs exposed by this MCP service.
MCP_OAUTH_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
MCP_REQUIRED_SCOPE=mcp:tools
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Tool selection lives in this YAML file; relative to the process working directory.
MCP_CONFIG_FILE=config.yaml

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=pardis-mcp

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional read-only integration. Set IAM endpoint, ECS endpoint and IdP ID together.
# Use verified Pardis API origins, not console URLs or public Huawei endpoints.
PARDIS_IAM_ENDPOINT=
PARDIS_ECS_ENDPOINT=
PARDIS_IDP_ID=
# Optional ECS planning discovery services. Use verified HTTPS API origins only.
# Flavors and zones use PARDIS_ECS_ENDPOINT; other catalogs require these origins.
PARDIS_VPC_ENDPOINT=
PARDIS_IMS_ENDPOINT=
PARDIS_EPS_ENDPOINT=
# Regional IAM project ID (32 hex), NOT an Enterprise Project ID.
# Set for enterprise-project-only users even if list_projects is empty.
# Otherwise discover projects after login and choose one. This grants no permissions.
PARDIS_PROJECT_ID=
# Optional PEM CA bundle for all cloud services. TLS verification stays enabled.
PARDIS_CA_BUNDLE=
