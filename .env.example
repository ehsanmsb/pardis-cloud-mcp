# Keycloak confidential client used only by the MCP backend.
OIDC_ISSUER_URL=https://keycloak.example.com/realms/snapp
OIDC_CLIENT_ID=pardis-mcp-backend
OIDC_CLIENT_SECRET=replace-me

# Public URLs exposed by this MCP service.
MCP_OAUTH_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
MCP_REQUIRED_SCOPE=mcp:tools
MCP_HOST=127.0.0.1
MCP_PORT=8000

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=pardis-mcp

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional read-only integration. Set IAM endpoint, ECS endpoint and IdP ID together.
# Use verified Pardis API origins, not console URLs or public Huawei endpoints.
PARDIS_IAM_ENDPOINT=
PARDIS_ECS_ENDPOINT=
PARDIS_IDP_ID=
# Optional default project; otherwise discover projects after login and choose one.
PARDIS_PROJECT_ID=
# Optional PEM CA bundle for both IAM and ECS. TLS verification stays enabled.
PARDIS_CA_BUNDLE=
